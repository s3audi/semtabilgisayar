        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".col-text": {
              "@media (min-width: 768px)": {
                "padding-bottom": "60px",
                "padding-top": "60px"
              },
              "@media (min-width: 992px)": {
                "padding-bottom": "120px",
                "padding-top": "120px"
              }
            },
            ".container": {
              "max-width": "1312px"
            },
            ".label-text": {
              "color": "#fb9a9a",
              "position": "relative",
              "z-index": "2"
            },
