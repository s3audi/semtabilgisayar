          "_name": "header1",
          "_sourceTheme": "edgem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header1\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"12\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Text\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1920x1238.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#643b1c\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#1a1a1a\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"align-center\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-text col-lg-{{textWidth}}\">\n                <p class=\"mbr-text label-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".label-text\">- 60.yılında Semta -<br><br></p>\n                <h1 class=\"mbr-section-title mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Bize göre herşey bulutta olmalı</b><br><b><br></b><b>Dijital dönüşümde yanınızdayız</b><br></h1>\n                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-primary\" href=\"#bottom\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>Bize ulaşın</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sREJOrWGph",
          "_anchor": "header1-1",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".container": {
              "max-width": "1312px"
            },
            ".row": {
              "padding": "0 1rem",
              "@media (max-width: 991px)": {
                "padding": "0 0.75rem"
              }
            },
            ".text-container": {
              "width": "100%",
              "padding": "0"
            },
            ".mbr-section-title": {
              "margin-bottom": "4rem",
              "width": "100%",
              "color": "#ffffff"
            },
            ".cards-container": {
              "display": "grid",
              "-webkit-box-orient": "vertical",
              "-webkit-box-direction": "normal",
              "-webkit-flex-direction": "column",
              "-ms-flex-direction": "column",
              "flex-direction": "column",
              "grid-auto-columns": "1fr",
              "grid-column-gap": "8rem",
              "grid-row-gap": "4rem",
              "-ms-grid-columns": "1fr 1fr 1fr",
              "grid-template-columns": "1fr 1fr 1fr",
              "-ms-grid-rows": "auto",
              "grid-template-rows": "auto",
              "padding": "0",
              "@media (max-width: 991px)": {
                "grid-column-gap": "4rem",
                "-ms-grid-columns": "1fr 1fr",
                "grid-template-columns": "1fr 1fr"
              },
              "@media (max-width: 767px)": {
                "max-width": "20rem",
                "margin-right": "auto",
                "margin-left": "auto",
                "-ms-grid-columns": "1fr",
                "grid-template-columns": "1fr"
              }
            },
            ".card-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center",
              "justify-content": "flex-start",
              "flex-wrap": "wrap",
              "text-align": "center",
              "@media (max-width: 767px)": {
                "margin-left": "auto",
                "margin-right": "auto"
              }
            },
            ".card-title": {
              "color": "#9c521b",
              "margin-bottom": "1rem",
              "text-align": "center"
            },
            ".card-text": {
              "color": "#643b1c"
            },
            ".mbr-iconfont": {
              "font-size": "25px",
              "color": "@iconColor"
            },
            ".icon-box": {
              "width": "100%",
              "margin-bottom": "1rem",
              "display": "flex",
              "justify-content": "center"
            }
