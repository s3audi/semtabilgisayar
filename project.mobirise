          "_name": "features5",
          "_sourceTheme": "edgem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Color\" name=\"iconColor\" value=\"#E1965F\" checked condition=\"showIcon\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background5.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-6 col-text\">\n                <div class=\"text-wrapper\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>Yardıma ihtiyacınız varsa lütfen bize yazın. Sizin için en uygun çözümü bulmak için buradayız.</b></h1>\n                    <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                        Nereden başlayacağınızı bilmiyor musunuz? Size yardımcı olalım.</p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 col-card\">\n                <div class=\"cards-container\">\n                    <div class=\"card\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" style=\"font-size: 30px;\"></span>\n                        </div>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\">Ağ yapılandırmasında dikkat edilmesi gerekenler nelerdir?\n                        </p>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardsAmount > 1\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" style=\"font-size: 30px;\"></span>\n                        </div>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\">\n                            Optimum Mobilite çözümü size hangi faktörlere bağlıdır?\n                        </p>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardsAmount > 2\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" style=\"font-size: 30px;\"></span>\n                        </div>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\">\n                            Yüksek performanslı bir bilgisayarda neler bulunmalı?</p>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardsAmount > 3\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" style=\"font-size: 30px;\"></span>\n                        </div>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\">\n                            Yedekleme için en uygun senaryo nedir?\n                        </p>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardsAmount > 4\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" style=\"font-size: 30px;\"></span>\n                        </div>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\">\n                            Server sistemlerinde en iyi altyapıyı nereden alabiliriz?\n                        </p>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardsAmount > 5\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" style=\"font-size: 30px;\"></span>\n                        </div>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\">\n                            Veri güvenliğini nasıl sağlayabiliriz?</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sREQMsHa2x",
          "_anchor": "features5-9",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".container": {
              "max-width": "1312px"
            },
            ".row": {
              "padding": "0 1rem",
              "@media (max-width: 991px)": {
                "padding": "0 0.75rem"
              }
            },
            ".text-container": {
              "width": "100%",
              "padding": "0"
            },
            ".mbr-section-title": {
              "margin-bottom": "4rem",
              "width": "100%",
              "color": "#002549"
            },
            ".cards-container": {
              "display": "grid",
              "-webkit-box-orient": "vertical",
              "-webkit-box-direction": "normal",
              "-webkit-flex-direction": "column",
              "-ms-flex-direction": "column",
              "flex-direction": "column",
              "grid-auto-columns": "1fr",
              "grid-column-gap": "8rem",
              "grid-row-gap": "4rem",
              "-ms-grid-columns": "1fr 1fr",
              "grid-template-columns": "1fr 1fr",
              "-ms-grid-rows": "auto",
              "grid-template-rows": "auto",
              "padding": "0",
              "@media (max-width: 991px)": {
                "max-width": "30rem",
                "margin-right": "auto",
                "margin-left": "auto",
                "-ms-grid-columns": "1fr",
                "grid-template-columns": "1fr"
              }
            },
            ".card-wrapper": {
              "display": "flex",
              "flex-direction": "row",
              "align-items": "flex-start",
              "justify-content": "flex-start",
              "flex-wrap": "nowrap",
              "@media (max-width: 991px)": {
                "flex-direction": "column"
              }
            },
            ".card-title": {
              "color": "#002549"
            },
            ".card-name-text": {
              "margin-top": "2rem"
            },
            ".card-name": {
              "color": "#003466"
            },
            ".card-prof": {
              "color": "#002549"
            },
            ".mbr-iconfont": {
              "font-size": "25px",
              "color": "@iconColor"
            },
            ".icon-box": {
              "margin-right": "2rem",
              "display": "flex",
              "justify-content": "center"
            }
          },
          "_name": "people1",
          "_sourceTheme": "edgem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"people1\" group=\"People\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Name\" name=\"showName\" checked>\n        <input type=\"checkbox\" title=\"Card Profession\" name=\"showProf\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Color\" name=\"iconColor\" value=\"#c17339\" selected condition=\"showIcon\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/pexels-jshoots-238118-1280x858.jpg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f0edeb\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"text-container\">\n                <h2 class=\"mbr-section-title mbr-fonts-style align-center\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Dost acı söyler</b></h2>\n            </div>\n            <div class=\"cards-container col-12\">\n                <div class=\"card\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-quote-left mobi-mbri\" style=\"font-size: 56px;\"></span>\n                        </div>\n                        <div class=\"card-box\">\n                            <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\"Öğrenen, gelişen, geliştiren bir kurum olmak için gösterdiğiniz çabalarınızı her zaman takdir ediyoruz. Çözüm ortağımız olarak bilişim sektöründe bugüne kadar olduğu gibi bundan sonra da sizlerle çalışmayı isteriz.\"</h4>\n                            <div class=\"card-name-text\">\n                                <p class=\"card-name mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".card-name\"><b>Hüseyin Çebi</b></p>\n                                <p class=\"card-prof mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showProf\" data-app-selector=\".card-prof\">Çebi Plastik</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card\" mbr-if=\"cardsAmount > 1\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-quote-left mobi-mbri\" style=\"font-size: 56px;\"></span>\n                        </div>\n                        <div class=\"card-box\">\n                            <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\"Mühendis bakışı, çözüm odaklı ilerleyiş. Empatik olarak kendinizi bizim yerimize koyarak en doğru olanı önerdiniz. Bilgiye ve veriye dayalı seçimleriniz sonucun tam da istediğimiz şekilde çıkmasını sağladı. Sorunsuz, uzun yıllar kullanabileceğimiz bir altyapıya kavuştuk.\"</h4>\n                            <div class=\"card-name-text\">\n                                <p class=\"card-name mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".card-name\"><b>Bulutlar Yapı</b></p>\n                                <p class=\"card-prof mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showProf\" data-app-selector=\".card-prof\">Mehmet Tekkan</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"card\" mbr-if=\"cardsAmount > 2\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-quote-left mobi-mbri\" style=\"font-size: 56px;\"></span>\n                        </div>\n                        <div class=\"card-box\">\n                            <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">“Sözde değil özde sonuçlar sunan, kaliteyi düşürmeden optimumu hedefleyen ve en önemlisi etik değerlere saygılı işortağımız Semta’ya bizimle birlikte olduğu için teşekkür ederiz.”</h4>\n                            <div class=\"card-name-text\">\n                                <p class=\"card-name mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".card-name\"><b>Yücel Keçeci</b></p>\n                                <p class=\"card-prof mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showProf\" data-app-selector=\".card-prof\">YD Kurumsal Yönetici</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card\" mbr-if=\"cardsAmount > 3\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-quote-left mobi-mbri\" style=\"font-size: 56px;\"></span>\n                        </div>\n                        <div class=\"card-box\">\n                            <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\"Önerdiğiniz SAAS uygulamaları ile oluşturduğunuz dijital ekosistem şirket içinde veri akışını beklediğimizin de ötesinde kusursuzlaştırdı. Bulut bilişim alanında sizi tüm tanıdıklarımıza tavsiye edeceğiz.\"</h4>\n                            <div class=\"card-name-text\">\n                                <p class=\"card-name mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".card-name\"><b>Tansiyon Sağlık</b></p>\n                                <p class=\"card-prof mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showProf\" data-app-selector=\".card-prof\">İrfan Ertan</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"card\" mbr-if=\"cardsAmount > 4\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-quote-left mobi-mbri\" style=\"font-size: 56px;\"></span>\n                        </div>\n                        <div class=\"card-box\">\n                            <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod.</h4>\n                            <div class=\"card-name-text\">\n                                <p class=\"card-name mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".card-name\"><b>Dillon Davis</b></p>\n                                <p class=\"card-prof mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showProf\" data-app-selector=\".card-prof\">CTO at Behand</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card\" mbr-if=\"cardsAmount > 5\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-quote-left mobi-mbri\" style=\"font-size: 56px;\"></span>\n                        </div>\n                        <div class=\"card-box\">\n                            <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.</h4>\n                            <div class=\"card-name-text\">\n                                <p class=\"card-name mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".card-name\"><b>Alex Clark</b></p>\n                                <p class=\"card-prof mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showProf\" data-app-selector=\".card-prof\">Main developer</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sRESk2744f",
          "_anchor": "people1-c",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "contact3",
          "_sourceTheme": "bistrom5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"contact3\" group=\"Contact\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Card</header>\n        <select title=\"Columns\" name=\"cardsWidth\">\n            <option value=\"12\">1</option>\n            <option value=\"6\">2</option>\n            <option value=\"4\">3</option>\n            <option value=\"3\" selected>4</option>\n        </select>\n        <input type=\"checkbox\" title=\"Auto Size\" name=\"autoSize\" checked>\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"5\" step=\"1\" value=\"5\" condition=\"!autoSize\">\n        <input type=\"checkbox\" title=\"Title\" name=\"cardTitle\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/bistrom5/components/_images/background.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Second Color\" name=\"bgColor2\" condition=\"bg.type == 'color'\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#ddbea9\" name=\"twoBgColor\" condition=\"bgColor2 && bg.type == 'color'\">\n        <input type=\"range\" name=\"bgHeight\" title=\"Proportion\" min=\"1\" max=\"10\" step=\"1\" value=\"4\" condition=\"bgColor2 && bg.type == 'color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n    <div class=\"two_background\"></div>\n    \n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-if=\"showTitle || showText\">\n            <div class=\"col-12 col-lg-12\">\n                <div class=\"head_title\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">CHOOSE A FAVORITE</h3>\n                    <p class=\"mbr-text mb-0 mbr-fonts-style\" mbr-if=\"showText\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-4\">Lorem ipsum dolor sit amet, consectetur adipisicing elit. Sit ex voluptatem voluptas aut quod, autem obcaecati molestiae optio consequuntur.</p>\n                </div>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}} active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mbr-838x471.jpg\" data-slide-to=\"0\" data-bs-slide-to=\"0\" alt>\n                        <div class=\"card_info\" mbr-if=\"cardTitle\">\n                            <h4 class=\"card_title mb-0 mbr-fonts-style\" data-app-selector=\".card_title\" mbr-theme-style=\"display-5\">YAPISAL KABLOLAMA</h4>\n                        </div>\n                    </div>\n                </div>\n            </div><div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}} active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mbr-838x530.jpg\" data-slide-to=\"1\" data-bs-slide-to=\"1\" alt>\n                        <div class=\"card_info\" mbr-if=\"cardTitle\">\n                            <h4 class=\"card_title mb-0 mbr-fonts-style\" data-app-selector=\".card_title\" mbr-theme-style=\"display-5\">NETWORK KURULUM</h4>\n                        </div>\n                    </div>\n                </div>\n            </div><div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}} active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mbr-838x559.jpg\" data-slide-to=\"2\" data-bs-slide-to=\"2\" alt>\n                        <div class=\"card_info\" mbr-if=\"cardTitle\">\n                            <h4 class=\"card_title mb-0 mbr-fonts-style\" data-app-selector=\".card_title\" mbr-theme-style=\"display-5\">MOBİLİTE</h4>\n                        </div>\n                    </div>\n                </div>\n            </div><div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}} active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mbr-1-838x559.jpg\" data-slide-to=\"3\" data-bs-slide-to=\"3\" alt>\n                        <div class=\"card_info\" mbr-if=\"cardTitle\">\n                            <h4 class=\"card_title mb-0 mbr-fonts-style\" data-app-selector=\".card_title\" mbr-theme-style=\"display-5\">VERİ GÜVENLİĞİ</h4>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "position": "relative",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".mbr-section-title": {
              "margin-bottom": "18px",
              "color": "#202020"
            },
            ".head_title": {
              "margin": "25px 0 58px",
              "text-align": "center"
            },
            "& when (@bgColor2) and (@bg-type = 'color')": {
              ".two_background": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "(@bgHeight * 10%)",
                "background-color": "@twoBgColor",
                "z-index": "0"
              }
            },
            "img, .item-img": {
              "width": "100%",
              "object-fit": "cover",
              "transition": "transform 0.35s cubic-bezier(0.4, 0.12, 0.4, 0.85)",
              "& when (@autoSize)": {
                "height": "100%"
              },
              "& when not (@autoSize)": {
                "height": "(@imageHeight * 100px)"
              }
            },
            ".item": {
              "margin-bottom": "30px"
            },
            ".item-wrapper": {
              "height": "100%",
              "display": "flex",
              "flex-flow": "column nowrap"
            },
            ".card_title": {
              "color": "#ffffff",
              "letter-spacing": ".075em",
              "line-height": "1.06em"
            },
            ".item-img": {
              "img": {
                "transform": "scale(1.05)"
              },
              "&:hover img": {
                "transform": "translateX(7px) scale(1.05)"
              },
              "position": "relative",
              "z-index": "1",
              ".card_info": {
                "z-index": "5",
                "position": "absolute",
                "top": "50%",
                "left": "50%",
                "display": "flex",
                "justify-content": "center",
                "align-items": "center",
                "width": "100%",
                "transform": "translate(-50%, -50%)",
                "padding": "0 12px"
              }
            }
          },
