                "& when not (@reverseContent)": {
                  "padding-right": "2rem"
                }
              }
            },
            ".text-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "flex-start"
            },
            ".mbr-section-title": {
              "margin-bottom": "1.3rem",
